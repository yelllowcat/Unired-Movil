generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  userId            Int       @id @default(autoincrement()) @map("user_id")
  fullName          String    @map("full_name") @db.VarChar(100)
  biography         String?   @db.Text
  profilePicture    String?   @default("default_avatar.png") @map("profile_picture") @db.VarChar(255)
  email             String    @unique @db.VarChar(100)
  password          String    @db.VarChar(255)
  registrationDate  DateTime  @default(now()) @map("registration_date")
  role              String    @default("user") @db.VarChar(20)
  active            Boolean   @default(true)
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  commentLikes      CommentLike[]
  replies           Reply[]
  hiddenComments    HiddenComment[]
  sentRequests      FriendRequest[]  @relation("Sender")
  receivedRequests  FriendRequest[]  @relation("Receiver")
  friendsAsUser1    Friend[]         @relation("FriendUser1")
  friendsAsUser2    Friend[]         @relation("FriendUser2")
  updateLogs        UserUpdateLog[]

  @@map("users")
}

model Post {
  postId     Int       @id @default(autoincrement()) @map("post_id")
  userId     Int       @map("user_id")
  content    String    @db.Text
  image      String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")
  active     Boolean   @default(true)

  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]

  @@map("posts")
}

model Comment {
  commentId  Int       @id @default(autoincrement()) @map("comment_id")
  postId     Int       @map("post_id")
  userId     Int       @map("user_id")
  content    String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  active     Boolean   @default(true)

  post           Post            @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  likes          CommentLike[]
  replies        Reply[]
  hiddenBy       HiddenComment[]

  @@map("comments")
}

model HiddenComment {
  hiddenId   Int       @id @default(autoincrement()) @map("hidden_id")
  userId     Int       @map("user_id")
  commentId  Int       @map("comment_id")
  hiddenAt   DateTime  @default(now()) @map("hidden_at")

  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  comment    Comment   @relation(fields: [commentId], references: [commentId], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("hidden_comments")
}

model Like {
  likeId   Int       @id @default(autoincrement()) @map("like_id")
  postId   Int       @map("post_id")
  userId   Int       @map("user_id")
  likedAt  DateTime  @default(now()) @map("liked_at")

  post     Post      @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("likes")
}

model CommentLike {
  likeId     Int       @id @default(autoincrement()) @map("like_id")
  commentId  Int       @map("comment_id")
  userId     Int       @map("user_id")
  likedAt    DateTime  @default(now()) @map("liked_at")

  comment    Comment   @relation(fields: [commentId], references: [commentId], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model Reply {
  replyId    Int       @id @default(autoincrement()) @map("reply_id")
  commentId  Int       @map("comment_id")
  userId     Int       @map("user_id")
  content    String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  active     Boolean   @default(true)

  comment    Comment   @relation(fields: [commentId], references: [commentId], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("replies")
}

model FriendRequest {
  requestId    Int       @id @default(autoincrement()) @map("request_id")
  senderId     Int       @map("sender_id")
  receiverId   Int       @map("receiver_id")
  status       String    @default("pending") @db.VarChar(20)
  requestDate  DateTime  @default(now()) @map("request_date")
  responseDate DateTime? @map("response_date")

  sender       User      @relation("Sender", fields: [senderId], references: [userId], onDelete: Cascade)
  receiver     User      @relation("Receiver", fields: [receiverId], references: [userId], onDelete: Cascade)

  @@map("friend_requests")
}

model Friend {
  friendshipId   Int       @id @default(autoincrement()) @map("friendship_id")
  userId1        Int       @map("user_id1")
  userId2        Int       @map("user_id2")
  friendshipDate DateTime  @default(now()) @map("friendship_date")

  user1          User      @relation("FriendUser1", fields: [userId1], references: [userId], onDelete: Cascade)
  user2          User      @relation("FriendUser2", fields: [userId2], references: [userId], onDelete: Cascade)

  @@unique([userId1, userId2])
  @@map("friends")
}

model UserUpdateLog {
  logId       Int       @id @default(autoincrement()) @map("log_id")
  userId      Int       @map("user_id")
  oldFullName String?   @map("old_full_name") @db.VarChar(100)
  newFullName String?   @map("new_full_name") @db.VarChar(100)
  oldBiography String?  @map("old_biography") @db.Text
  newBiography String?  @map("new_biography") @db.Text
  changeDate  DateTime  @default(now()) @map("change_date")

  user        User      @relation(fields: [userId], references: [userId])

  @@map("user_update_log")
}
